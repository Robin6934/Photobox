<Window
  x:Class="Photobox.UI.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="MainWindow"
  WindowState="Maximized"
  WindowStyle="None"
  Style="{StaticResource MaterialDesignWindow}"
>
  <Grid Background="Black">
    <!-- 🔴 LIVE CAMERA VIEW -->
    <Image
      Source="{Binding VideoFrame}"
      Stretch="UniformToFill"
      RenderOptions.BitmapScalingMode="LowQuality"
      SnapsToDevicePixels="True"
    />
    <!-- 🟦 CENTER OVERLAY TEXT -->
    <Border
      Background="#80000000"
      Height="120"
      VerticalAlignment="Center"
      HorizontalAlignment="Stretch"
    >
      <TextBlock
        Text="Bildschirm berühren"
        FontSize="60"
        Foreground="White"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
      />
    </Border>
    <!-- 🟢 FULLSCREEN TOUCH BUTTON -->
    <Button Background="Transparent" Command="{Binding TakePictureCommand}" />
    <!-- 🔵 QR CODE -->
    <Image
      Source="{Binding QrCodeImage}"
      Width="150"
      Height="150"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Margin="20"
    />
  </Grid>
</Window>
